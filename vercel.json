{
  "buildCommand": "pnpm -r --if-present run build",
  "outputDirectory": "artifacts/agendamento-dac/dist/public",
  "functions": {
    "api/home.js": {
      "includeFiles": [
        "artifacts/agendamento-dac/index.html",
        "artifacts/agendamento-dac/index-teste.html"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/index.html",
      "destination": "/api/home"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/avaliador",
      "destination": "/avaliador.html"
    },
    {
      "source": "/termo",
      "destination": "/termo.html"
    },
    {
      "source": "/registro-atividades",
      "destination": "/registro-atividades.html"
    },
    {
      "source": "/registro-atividades/:path*",
      "destination": "/registro-atividades.html"
    }
  ]
}
